---
import AuthorityTrace from '../components/AuthorityTrace.astro';
import LyraScenario from '../components/LyraScenario.astro';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const canonical = new URL(`${base}/`, Astro.site).toString();
const repoUrl = 'https://github.com/George-RD/openspine';
const cloneCommand = `git clone https://github.com/George-RD/openspine.git
cd openspine
npm ci
cargo build --workspace
./scripts/check.sh`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#eef3f0" />
		<meta
			name="description"
			content="OpenSpine is a self-hosted personal AI system designed to grow through delegation. Lyra can learn repeated work, but new responsibilities stay reviewed, limited, and revocable."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content="OpenSpine — Let your AI earn more responsibility" />
		<meta
			property="og:description"
			content="Delegate one task, review the result, and let repeated work become clear, revocable responsibility. Lyra can learn the job; it cannot promote itself."
		/>
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<title>OpenSpine — Personal AI that grows through delegation</title>
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header" data-site-header>
			<a class="brand" href={`${base}/`} aria-label="OpenSpine home">
				<svg class="brand-symbol" viewBox="0 0 44 44" aria-hidden="true">
					<path d="M8 5h28v34H8z" />
					<path d="M14 13h16M14 22h16M14 31h16" />
					<circle cx="22" cy="13" r="2.7" />
					<circle cx="22" cy="22" r="2.7" />
					<circle cx="22" cy="31" r="2.7" />
				</svg>
				<span class="brand-word">OpenSpine</span>
				<span class="brand-status">alpha</span>
			</a>

			<nav class="primary-nav" aria-label="Primary navigation">
				<a class="nav-anchor" href="#mechanism">How it grows</a>
				<a class="nav-anchor" href="#proof">Proof</a>
				<a href={href('/quickstart/')}>Docs</a>
				<a class="repo-link" href={repoUrl} target="_blank" rel="noreferrer">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</nav>
		</header>

		<main id="main">
			<!--
			THESIS: The buyer wants an employee-like personal AI whose useful autonomy grows through delegation, without the AI silently accumulating authority.
			OWN-WORLD: A pale safety-case instrument with deep ink, safety orange, clipped panels, delegation rails, proof ledgers, and precise status marks.
			STORY: A personal-agent buyer sees the employee-like promise, learns how repeated work becomes reviewed responsibility, then inspects the first working task boundary and named proof.
			FIRST VIEWPORT: The growth promise on the left; one real bounded task on the right. The Gmail path is evidence of the first rung, not the product ceiling.
			FORM: Asymmetric control-instrument landing page; product promise first, growth model second, current alpha and proof third, no literal spine imagery.
			-->
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy" data-reveal>
					<div class="hero-badge">
						<span class="hero-badge-dot" aria-hidden="true"></span>
						Self-hosted personal AI · grows by delegation · alpha
					</div>
					<h1 id="hero-title">
						Let your AI earn more responsibility.<br />
						<span>One job at a time.</span>
					</h1>
					<p class="hero-lede">
						OpenSpine comes with Lyra, the assistant you talk to. Give it one clear job, review the result, then let repeated work become a responsibility you can inspect, limit, pause, or remove. Lyra can learn the job. It cannot promote itself.
					</p>
					<div class="hero-actions">
						<a class="button button--primary" href="#mechanism">
							See how responsibility grows
							<span aria-hidden="true">→</span>
						</a>
						<a class="button button--secondary" href={href('/quickstart/')}>
							Run the alpha
						</a>
					</div>
					<div class="hero-audience" aria-label="Why OpenSpine exists">
						<div>
							<strong>Seen what OpenClaw or Hermes can do?</strong>
							<span>OpenSpine is built for what comes next: delegate, review, then let useful autonomy grow through clear responsibilities.</span>
						</div>
						<div>
							<strong>No silent promotion</strong>
							<span>New routines and permissions stay inactive until you approve them. Pause or revoke them later.</span>
						</div>
					</div>
				</div>

				<div class="hero-instrument" data-reveal data-reveal-delay="1">
					<AuthorityTrace />
				</div>
			</section>

			<section class="mechanism-section" id="mechanism" aria-labelledby="mechanism-title">
				<div class="section-shell mechanism-layout">
					<div class="mechanism-intro" data-reveal>
						<span class="section-marker">How autonomy grows</span>
						<h2 id="mechanism-title">Delegation becomes capability, one reviewed step at a time.</h2>
						<p>You should not have to choose between an assistant that asks forever and one that starts with broad access.</p>
						<p><strong>Alpha status:</strong> the runtime support exists, but the complete owner-facing delegation loop is still being wired into Lyra.</p>
						<a class="text-link text-link--light" href={href('/why-openspine/')}>
							Why the growth model matters <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="boundary-sequence" data-reveal data-reveal-delay="1">
						<article class="boundary-row">
							<div class="boundary-mark" aria-hidden="true">
								<svg viewBox="0 0 34 34"><path d="M17 3 28 7.5v8.4c0 6.7-4.4 11.8-11 14.1C10.4 27.7 6 22.6 6 15.9V7.5L17 3Z" /><path d="m11.8 16.7 3.2 3.2 7.2-7.2" /></svg>
							</div>
							<div>
								<h3>Start with one clear job</h3>
								<p>Lyra gets only the context, tools, and actions needed for that task. The task ends; its access ends with it.</p>
							</div>
							<code>delegate → bounded task</code>
						</article>

						<article class="boundary-row">
							<div class="boundary-mark" aria-hidden="true">
								<svg viewBox="0 0 34 34"><path d="M5 8h24M8 17h18M11 26h12" /><circle cx="11" cy="8" r="2.5" /><circle cx="21" cy="17" r="2.5" /><circle cx="15" cy="26" r="2.5" /></svg>
							</div>
							<div>
								<h3>Turn repetition into a proposal</h3>
								<p>Repeated approvals, corrections, and preferences can produce a reviewable proposal for a routine or rule. Nothing changes yet.</p>
							</div>
							<code>repeat → reviewable proposal</code>
						</article>

						<article class="boundary-row">
							<div class="boundary-mark" aria-hidden="true">
								<svg viewBox="0 0 34 34"><path d="M5 17h24" /><path d="M17 5v24" /><circle cx="17" cy="17" r="6" /><path d="m14.2 17 2 2 4-4" /></svg>
							</div>
							<div>
								<h3>Approve the responsibility, not unlimited access</h3>
								<p>You choose the targets, actions, budget, and expiry. Matching work needs less interruption; drift or a changed context comes back to you.</p>
							</div>
							<code>approve → revocable rule</code>
						</article>
					</div>
				</div>

				<div class="spine-statement" aria-hidden="true">
					<span>delegate</span><i></i><span>work</span><i></i><span>review</span><i></i><span>propose</span><i></i><span>approve</span><i></i><span>repeat</span><i></i><span>revoke</span>
				</div>
			</section>

			<section class="lyra-section" aria-labelledby="lyra-title">
				<div class="section-shell">
					<header class="section-heading section-heading--split" data-reveal>
						<div>
							<span class="section-marker">First working rungs</span>
							<h2 id="lyra-title">OpenSpine is the system.<br />Lyra grows through delegated work.</h2>
						</div>
						<div class="section-heading-copy">
							<p>Today, Lyra can chat locally and complete one guarded Gmail drafting flow. Those paths prove the first task boundary. Underneath them, OpenSpine already has contained workers, declarative workflows, standing rules, and governed learning.</p>
							<span class="scope-note">Current owner-facing breadth is narrow. The natural progression from one task to reusable responsibility is tracked in <a href={`${repoUrl}/issues/123`} target="_blank" rel="noreferrer">issue #123</a>.</span>
						</div>
					</header>

					<div data-reveal data-reveal-delay="1">
						<LyraScenario />
					</div>
				</div>
			</section>

			<section class="proof-section" id="proof" aria-labelledby="proof-title">
				<div class="section-shell">
					<header class="proof-heading" data-reveal>
						<div>
							<span class="section-marker">Why believe it cannot promote itself</span>
							<h2 id="proof-title">Lyra can propose. The runtime decides what becomes active.</h2>
						</div>
						<p>Each public boundary claim points to a named test. If the test disappears, the build fails.</p>
					</header>

					<div class="claim-ledger" data-reveal data-reveal-delay="1">
						<div class="claim-ledger-head" aria-hidden="true">
							<span>Failure scene</span>
							<span>Runtime result</span>
							<span>Named test</span>
						</div>
						<article class="claim-row">
							<strong>A proposed capability change</strong>
							<p>Stays inactive until the owner-approved lifecycle completes.</p>
							<code>widening_via_a_proposed_pack_requires_approval_first</code>
						</article>
						<article class="claim-row">
							<strong>A different Gmail thread</strong>
							<p>Denied because the task is bound to one selected thread.</p>
							<code>email_read_selected_thread_rejects_foreign_grant</code>
						</article>
						<article class="claim-row">
							<strong>A request for raw credentials</strong>
							<p>The agent process never received connector credentials.</p>
							<code>process_driver_clears_env_and_sets_only_two_vars</code>
						</article>
						<article class="claim-row">
							<strong>An attempt to send email</strong>
							<p>Denied even if a grant or approval says otherwise.</p>
							<code>global_policy_round_trips_and_denies_send</code>
						</article>
					</div>

					<div class="proof-actions" data-reveal>
						<a class="button button--ink" href={href('/threat-model/')}>See every claim and test</a>
						<a class="text-link" href={`${repoUrl}/blob/main/docs/threat-claims.md`} target="_blank" rel="noreferrer">
							Open the source file <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="start-section" aria-labelledby="start-title">
				<div class="section-shell start-layout">
					<div class="start-copy" data-reveal>
						<span class="section-marker section-marker--dark">Current alpha</span>
						<h2 id="start-title">Try the first rung.<br />Inspect the system built to grow.</h2>
						<p>The alpha is narrow and technical. Start with local chat or connect Telegram and Gmail for the guarded draft flow. Then inspect the same tests and claims used by CI.</p>
						<div class="start-actions">
							<a class="button button--dark" href={href('/quickstart/')}>
								Run the alpha <span aria-hidden="true">→</span>
							</a>
							<a class="button button--ghost-dark" href={href('/roadmap/')}>See the product roadmap</a>
						</div>
						<p class="alpha-note"><strong>Alpha:</strong> current owner-facing workflows are narrow. The progressive delegation loop is the next product milestone, not a shipped claim.</p>
					</div>

					<div class="command-panel" data-reveal data-reveal-delay="1">
						<div class="command-bar">
							<span>Terminal</span>
							<button type="button" class="copy-button" data-copy-command>
								<span class="copy-label">Copy</span>
							</button>
						</div>
						<pre><code data-command-text>{cloneCommand}</code></pre>
						<div class="command-result">
							<span class="status-light status-light--large" aria-hidden="true"></span>
							<span>Same test and claim checks as CI</span>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-main">
				<a class="brand brand--footer" href={`${base}/`} aria-label="OpenSpine home">
					<svg class="brand-symbol" viewBox="0 0 44 44" aria-hidden="true">
						<path d="M8 5h28v34H8z" />
						<path d="M14 13h16M14 22h16M14 31h16" />
						<circle cx="22" cy="13" r="2.7" />
						<circle cx="22" cy="22" r="2.7" />
						<circle cx="22" cy="31" r="2.7" />
					</svg>
					<span class="brand-word">OpenSpine</span>
				</a>
				<p>A personal AI system where responsibility grows through reviewed delegation.</p>
			</div>
			<nav class="footer-nav" aria-label="Footer navigation">
				<a href={href('/why-openspine/')}>Why OpenSpine</a>
				<a href={href('/architecture/')}>Architecture</a>
				<a href={href('/comparison/')}>How it differs</a>
				<a href={href('/roadmap/')}>Roadmap</a>
				<a href={repoUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
			</nav>
			<a class="support-link" href="https://ko-fi.com/george_builds" target="_blank" rel="noreferrer">Support the work ↗</a>
		</footer>

		<script>
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

			const revealItems = document.querySelectorAll('[data-reveal]');
			if (reducedMotion.matches || !('IntersectionObserver' in window)) {
				revealItems.forEach((item) => item.classList.add('is-visible'));
			} else {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
				);
				revealItems.forEach((item) => revealObserver.observe(item));
			}

			const trace = document.querySelector('[data-trace]');
			const replayButton = document.querySelector('[data-trace-replay]');
			const runTrace = () => {
				if (!(trace instanceof HTMLElement) || reducedMotion.matches) return;
				trace.classList.remove('is-running');
				void trace.offsetWidth;
				trace.classList.add('is-running');
			};
			window.setTimeout(runTrace, 420);
			replayButton?.addEventListener('click', runTrace);

			if (trace instanceof HTMLElement && window.matchMedia('(pointer: fine)').matches && !reducedMotion.matches) {
				let frame = 0;
				trace.addEventListener('pointermove', (event) => {
					window.cancelAnimationFrame(frame);
					frame = window.requestAnimationFrame(() => {
						const bounds = trace.getBoundingClientRect();
						const x = (event.clientX - bounds.left) / bounds.width - 0.5;
						const y = (event.clientY - bounds.top) / bounds.height - 0.5;
						trace.style.setProperty('--tilt-y', `${x * 2.2}deg`);
						trace.style.setProperty('--tilt-x', `${y * -1.8}deg`);
					});
				});
				trace.addEventListener('pointerleave', () => {
					trace.style.setProperty('--tilt-y', '0deg');
					trace.style.setProperty('--tilt-x', '0deg');
				});
			}

			const copyButton = document.querySelector('[data-copy-command]');
			copyButton?.addEventListener('click', async () => {
				const command = document.querySelector('[data-command-text]')?.textContent?.trim();
				if (!command || !(copyButton instanceof HTMLButtonElement)) return;
				try {
					await navigator.clipboard.writeText(command);
					const label = copyButton.querySelector('.copy-label');
					if (label) label.textContent = 'Copied';
					window.setTimeout(() => {
						if (label) label.textContent = 'Copy';
					}, 1800);
				} catch {
					copyButton.classList.add('copy-failed');
					const label = copyButton.querySelector('.copy-label');
					if (label) label.textContent = 'Select text';
				}
			});

			let lastScroll = 0;
			const header = document.querySelector('[data-site-header]');
			window.addEventListener(
				'scroll',
				() => {
					const current = window.scrollY;
					if (header instanceof HTMLElement) {
						header.classList.toggle('is-scrolled', current > 12);
						header.classList.toggle('is-hidden', current > lastScroll && current > 220);
					}
					lastScroll = current;
				},
				{ passive: true },
			);
		</script>
	</body>
</html>
