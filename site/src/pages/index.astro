---
import AuthorityTrace from '../components/AuthorityTrace.astro';
import LyraScenario from '../components/LyraScenario.astro';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const canonical = new URL(`${base}/`, Astro.site).toString();
const repoUrl = 'https://github.com/George-RD/openspine';
const cloneCommand = `git clone https://github.com/George-RD/openspine.git
cd openspine
npm ci
cargo build --workspace
./scripts/check.sh`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#eef3f0" />
		<meta
			name="description"
			content="OpenSpine is a self-hosted permission layer for AI assistants. It limits each task, checks every action, and keeps raw credentials outside the model."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content="OpenSpine — Let AI use your tools. Keep the keys." />
		<meta
			property="og:description"
			content="Give an AI assistant limited access to email and connected tools without handing the model raw credentials or control of the rules."
		/>
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<title>OpenSpine — Permissions for AI assistants</title>
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header" data-site-header>
			<a class="brand" href={`${base}/`} aria-label="OpenSpine home">
				<svg class="brand-symbol" viewBox="0 0 44 44" aria-hidden="true">
					<path d="M8 5h28v34H8z" />
					<path d="M14 13h16M14 22h16M14 31h16" />
					<circle cx="22" cy="13" r="2.7" />
					<circle cx="22" cy="22" r="2.7" />
					<circle cx="22" cy="31" r="2.7" />
				</svg>
				<span class="brand-word">OpenSpine</span>
				<span class="brand-status">alpha</span>
			</a>

			<nav class="primary-nav" aria-label="Primary navigation">
				<a class="nav-anchor" href="#mechanism">How it works</a>
				<a class="nav-anchor" href="#proof">Proof</a>
				<a href={href('/quickstart/')}>Docs</a>
				<a class="repo-link" href={repoUrl} target="_blank" rel="noreferrer">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</nav>
		</header>

		<main id="main">
			<!--
			THESIS: Agent safety belongs in a runtime boundary, not a prompt; refuse the stock dark-neon security landing page.
			OWN-WORLD: A pale safety-case instrument with deep ink, safety orange, clipped panels, authority rails, proof ledgers, and precise status marks.
			STORY: A skeptical builder understands the category first, sees one task become limited permissions, watches risky actions get checked, then inspects the proof.
			FIRST VIEWPORT: Plain-language category and benefit on the left; a live task trace on the right visibly denies email.send. The primary action sits under the offer.
			FORM: Asymmetric control-instrument landing page; mechanism-first staging, no card-grid hero, no literal spine imagery.
			-->
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy" data-reveal>
					<div class="hero-badge">
						<span class="hero-badge-dot" aria-hidden="true"></span>
						Self-hosted permissions for AI assistants · alpha
					</div>
					<h1 id="hero-title">
						Let AI use your tools.<br />
						<span>Keep the keys.</span>
					</h1>
					<p class="hero-lede">
						OpenSpine sits between the model and your email or apps. Each task gets only the access it needs. It checks every action, asks you when approval is needed, and records the result. The model never sees raw credentials.
					</p>
					<div class="hero-actions">
						<a class="button button--primary" href={href('/quickstart/')}>
							Run the quickstart
							<span aria-hidden="true">→</span>
						</a>
						<a class="button button--secondary" href={href('/threat-model/')}>
							Read the threat model
						</a>
					</div>
					<div class="hero-audience" aria-label="Who OpenSpine is for">
						<div>
							<strong>For self-hosters</strong>
							<span>Connect an assistant to real accounts without giving the model full access.</span>
						</div>
						<div>
							<strong>For agent builders</strong>
							<span>Put permissions in code you can test, not in a system prompt.</span>
						</div>
					</div>
				</div>

				<div class="hero-instrument" data-reveal data-reveal-delay="1">
					<AuthorityTrace />
				</div>
			</section>

			<section class="mechanism-section" id="mechanism" aria-labelledby="mechanism-title">
				<div class="section-shell mechanism-layout">
					<div class="mechanism-intro" data-reveal>
						<span class="section-marker">How one task stays in bounds</span>
						<h2 id="mechanism-title">The model requests.<br />OpenSpine decides.</h2>
						<p>A malicious email can change what the model tries to do. It cannot change what OpenSpine allows.</p>
						<a class="text-link text-link--light" href={href('/architecture/')}>
							See the architecture <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="boundary-sequence" data-reveal data-reveal-delay="1">
						<article class="boundary-row">
							<div class="boundary-mark" aria-hidden="true">
								<svg viewBox="0 0 34 34"><path d="M17 3 28 7.5v8.4c0 6.7-4.4 11.8-11 14.1C10.4 27.7 6 22.6 6 15.9V7.5L17 3Z" /><path d="m11.8 16.7 3.2 3.2 7.2-7.2" /></svg>
							</div>
							<div>
								<h3>Check who asked</h3>
								<p>OpenSpine verifies the source before trusting the sender. A matching user ID is not enough on its own.</p>
							</div>
							<code>request → verify source</code>
						</article>

						<article class="boundary-row">
							<div class="boundary-mark" aria-hidden="true">
								<svg viewBox="0 0 34 34"><path d="M5 8h24M8 17h18M11 26h12" /><circle cx="11" cy="8" r="2.5" /><circle cx="21" cy="17" r="2.5" /><circle cx="15" cy="26" r="2.5" /></svg>
							</div>
							<div>
								<h3>Set the task limits</h3>
								<p>OpenSpine combines the route, agent, workflow, capabilities, and policy into one short-lived task grant. If no rule allows an action, the task does not get it.</p>
							</div>
							<code>rules → task grant</code>
						</article>

						<article class="boundary-row">
							<div class="boundary-mark" aria-hidden="true">
								<svg viewBox="0 0 34 34"><path d="M5 17h24" /><path d="M17 5v24" /><circle cx="17" cy="17" r="6" /><path d="m14.2 17 2 2 4-4" /></svg>
							</div>
							<div>
								<h3>Check every action</h3>
								<p>Before email or another connector runs, OpenSpine allows the action, blocks it, or asks you. The result is logged.</p>
							</div>
							<code>action → allow | ask | deny</code>
						</article>
					</div>
				</div>

				<div class="spine-statement" aria-hidden="true">
					<span>request</span><i></i><span>verify</span><i></i><span>match</span><i></i><span>limit</span><i></i><span>run</span><i></i><span>decide</span><i></i><span>record</span>
				</div>
			</section>

			<section class="lyra-section" aria-labelledby="lyra-title">
				<div class="section-shell">
					<header class="section-heading section-heading--split" data-reveal>
						<div>
							<span class="section-marker">A working example</span>
							<h2 id="lyra-title">Lyra drafts the reply.<br />Sending stays with you.</h2>
						</div>
						<div class="section-heading-copy">
							<p>Send Lyra a Gmail thread ID in Telegram. It can read only that thread, draft a reply, and create a Gmail draft after you approve the exact text. OpenSpine blocks email sending.</p>
							<span class="scope-note">Current alpha scope. The interface below is illustrative.</span>
						</div>
					</header>

					<div data-reveal data-reveal-delay="1">
						<LyraScenario />
					</div>
				</div>
			</section>

			<section class="proof-section" id="proof" aria-labelledby="proof-title">
				<div class="section-shell">
					<header class="proof-heading" data-reveal>
						<div>
							<span class="section-marker">Claims you can test</span>
							<h2 id="proof-title">Every safety claim points to a test.</h2>
						</div>
						<p>The build fails if a listed test disappears. Clone the repo and run the same checks yourself.</p>
					</header>

					<div class="claim-ledger" data-reveal data-reveal-delay="1">
						<div class="claim-ledger-head" aria-hidden="true">
							<span>Risk</span>
							<span>Runtime result</span>
							<span>Named test</span>
						</div>
						<article class="claim-row">
							<strong>Unverified owner request</strong>
							<p>Denied because the source was not verified.</p>
							<code>spoofed_owner_id_without_verified_source_is_denied</code>
						</article>
						<article class="claim-row">
							<strong>Reading a different thread</strong>
							<p>Denied because the task is bound to one selected thread.</p>
							<code>email_read_selected_thread_rejects_foreign_grant</code>
						</article>
						<article class="claim-row">
							<strong>Raw credentials</strong>
							<p>The agent process receives no connector credentials.</p>
							<code>process_driver_clears_env_and_sets_only_two_vars</code>
						</article>
						<article class="claim-row">
							<strong>Email sending</strong>
							<p>Denied even if a grant or approval says otherwise.</p>
							<code>global_policy_round_trips_and_denies_send</code>
						</article>
					</div>

					<div class="proof-actions" data-reveal>
						<a class="button button--ink" href={href('/threat-model/')}>See every claim and test</a>
						<a class="text-link" href={`${repoUrl}/blob/main/docs/threat-claims.md`} target="_blank" rel="noreferrer">
							Open the source file <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="start-section" aria-labelledby="start-title">
				<div class="section-shell start-layout">
					<div class="start-copy" data-reveal>
						<span class="section-marker section-marker--dark">Try the alpha</span>
						<h2 id="start-title">Run the checks.<br />Then connect Lyra.</h2>
						<p>Clone OpenSpine and run the same test and claim checks used by CI. The quickstart then covers Telegram, Gmail, and model setup.</p>
						<div class="start-actions">
							<a class="button button--dark" href={href('/quickstart/')}>
								Open the quickstart <span aria-hidden="true">→</span>
							</a>
							<a class="button button--ghost-dark" href={repoUrl} target="_blank" rel="noreferrer">View on GitHub</a>
						</div>
						<p class="alpha-note"><strong>Alpha:</strong> the permission layer and Lyra run end to end. The roadmap lists what is still missing.</p>
					</div>

					<div class="command-panel" data-reveal data-reveal-delay="1">
						<div class="command-bar">
							<span>Terminal</span>
							<button type="button" class="copy-button" data-copy-command>
								<span class="copy-label">Copy</span>
							</button>
						</div>
						<pre><code data-command-text>{cloneCommand}</code></pre>
						<div class="command-result">
							<span class="status-light status-light--large" aria-hidden="true"></span>
							<span>Same test and claim checks as CI</span>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-main">
				<a class="brand brand--footer" href={`${base}/`} aria-label="OpenSpine home">
					<svg class="brand-symbol" viewBox="0 0 44 44" aria-hidden="true">
						<path d="M8 5h28v34H8z" />
						<path d="M14 13h16M14 22h16M14 31h16" />
						<circle cx="22" cy="13" r="2.7" />
						<circle cx="22" cy="22" r="2.7" />
						<circle cx="22" cy="31" r="2.7" />
					</svg>
					<span class="brand-word">OpenSpine</span>
				</a>
				<p>Permissions for AI assistants, enforced outside the model.</p>
			</div>
			<nav class="footer-nav" aria-label="Footer navigation">
				<a href={href('/why-openspine/')}>Why OpenSpine</a>
				<a href={href('/architecture/')}>Architecture</a>
				<a href={href('/roadmap/')}>Roadmap</a>
				<a href={repoUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
			</nav>
			<a class="support-link" href="https://ko-fi.com/george_builds" target="_blank" rel="noreferrer">Support the work ↗</a>
		</footer>

		<script>
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

			const revealItems = document.querySelectorAll('[data-reveal]');
			if (reducedMotion.matches || !('IntersectionObserver' in window)) {
				revealItems.forEach((item) => item.classList.add('is-visible'));
			} else {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
				);
				revealItems.forEach((item) => revealObserver.observe(item));
			}

			const trace = document.querySelector('[data-trace]');
			const replayButton = document.querySelector('[data-trace-replay]');
			const runTrace = () => {
				if (!(trace instanceof HTMLElement) || reducedMotion.matches) return;
				trace.classList.remove('is-running');
				void trace.offsetWidth;
				trace.classList.add('is-running');
			};
			window.setTimeout(runTrace, 420);
			replayButton?.addEventListener('click', runTrace);

			if (trace instanceof HTMLElement && window.matchMedia('(pointer: fine)').matches && !reducedMotion.matches) {
				let frame = 0;
				trace.addEventListener('pointermove', (event) => {
					window.cancelAnimationFrame(frame);
					frame = window.requestAnimationFrame(() => {
						const bounds = trace.getBoundingClientRect();
						const x = (event.clientX - bounds.left) / bounds.width - 0.5;
						const y = (event.clientY - bounds.top) / bounds.height - 0.5;
						trace.style.setProperty('--tilt-y', `${x * 2.2}deg`);
						trace.style.setProperty('--tilt-x', `${y * -1.8}deg`);
					});
				});
				trace.addEventListener('pointerleave', () => {
					trace.style.setProperty('--tilt-y', '0deg');
					trace.style.setProperty('--tilt-x', '0deg');
				});
			}

			const copyButton = document.querySelector('[data-copy-command]');
			copyButton?.addEventListener('click', async () => {
				const command = document.querySelector('[data-command-text]')?.textContent?.trim();
				if (!command || !(copyButton instanceof HTMLButtonElement)) return;
				try {
					await navigator.clipboard.writeText(command);
					const label = copyButton.querySelector('.copy-label');
					if (label) label.textContent = 'Copied';
					window.setTimeout(() => {
						if (label) label.textContent = 'Copy';
					}, 1800);
				} catch {
					copyButton.classList.add('copy-failed');
					const label = copyButton.querySelector('.copy-label');
					if (label) label.textContent = 'Select text';
				}
			});

			let lastScroll = 0;
			const header = document.querySelector('[data-site-header]');
			window.addEventListener(
				'scroll',
				() => {
					const current = window.scrollY;
					if (header instanceof HTMLElement) {
						header.classList.toggle('is-scrolled', current > 12);
						header.classList.toggle('is-hidden', current > lastScroll && current > 220);
					}
					lastScroll = current;
				},
				{ passive: true },
			);
		</script>
	</body>
</html>
