---
import AuthorityTrace from '../components/AuthorityTrace.astro';
import LyraScenario from '../components/LyraScenario.astro';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const canonical = new URL(`${base}/`, Astro.site).toString();
const repoUrl = 'https://github.com/George-RD/openspine';
const cloneCommand = `git clone https://github.com/George-RD/openspine.git
cd openspine
npm ci
cargo build --workspace
./scripts/check.sh`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#eef3f0" />
		<meta
			name="description"
			content="OpenSpine is a self-hostable runtime that keeps agent authority outside the model. Verify every event, issue scoped grants, gate every effect, and audit the result."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content="OpenSpine — Give agents access. Keep the authority." />
		<meta
			property="og:description"
			content="A self-hostable runtime for governed agents, with runtime-enforced boundaries and test-backed security claims."
		/>
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<title>OpenSpine — Runtime-enforced authority for agents</title>
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header" data-site-header>
			<a class="brand" href={`${base}/`} aria-label="OpenSpine home">
				<svg class="brand-symbol" viewBox="0 0 44 44" aria-hidden="true">
					<path d="M8 5h28v34H8z" />
					<path d="M14 13h16M14 22h16M14 31h16" />
					<circle cx="22" cy="13" r="2.7" />
					<circle cx="22" cy="22" r="2.7" />
					<circle cx="22" cy="31" r="2.7" />
				</svg>
				<span class="brand-word">OpenSpine</span>
				<span class="brand-status">alpha</span>
			</a>

			<nav class="primary-nav" aria-label="Primary navigation">
				<a class="nav-anchor" href="#mechanism">How it works</a>
				<a class="nav-anchor" href="#proof">Proof</a>
				<a href={href('/quickstart/')}>Docs</a>
				<a class="repo-link" href={repoUrl} target="_blank" rel="noreferrer">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</nav>
		</header>

		<main id="main">
			<!--
			THESIS: Agent safety belongs in a runtime boundary, not a prompt; refuse the stock dark-neon security landing page.
			OWN-WORLD: A pale safety-case instrument with deep ink, safety orange, clipped panels, authority rails, proof ledgers, and precise status marks.
			STORY: A skeptical builder sees one request become a scoped grant, watches risky effects get gated, checks named tests, then opens the quickstart.
			FIRST VIEWPORT: Plain-language offer on the left; a large live authority trace on the right visibly denies email.send. The primary action sits under the offer.
			FORM: Asymmetric control-instrument landing page; mechanism-first staging, no card-grid hero, no literal spine imagery.
			-->
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy" data-reveal>
					<div class="hero-badge">
						<span class="hero-badge-dot" aria-hidden="true"></span>
						Open source · self-hostable · alpha
					</div>
					<h1 id="hero-title">
						Give agents access.<br />
						<span>Keep the authority.</span>
					</h1>
					<p class="hero-lede">
						OpenSpine lets an assistant work with real email and tools without handing the model the keys. The runtime verifies each event, issues a narrow task grant, gates every effect, and records what happened.
					</p>
					<div class="hero-actions">
						<a class="button button--primary" href={href('/quickstart/')}>
							Run the quickstart
							<span aria-hidden="true">→</span>
						</a>
						<a class="button button--secondary" href={href('/threat-model/')}>
							Read the threat model
						</a>
					</div>
					<div class="hero-audience" aria-label="Who OpenSpine is for">
						<div>
							<strong>For self-hosters</strong>
							<span>Let an assistant help with real admin without blanket access.</span>
						</div>
						<div>
							<strong>For agent builders</strong>
							<span>Move authority out of prompts and into code you can test.</span>
						</div>
					</div>
				</div>

				<div class="hero-instrument" data-reveal data-reveal-delay="1">
					<AuthorityTrace />
				</div>
			</section>

			<section class="mechanism-section" id="mechanism" aria-labelledby="mechanism-title">
				<div class="section-shell mechanism-layout">
					<div class="mechanism-intro" data-reveal>
						<span class="section-marker">The control boundary</span>
						<h2 id="mechanism-title">The model reasons.<br />The spine decides.</h2>
						<p>A prompt injection can change what the model wants. It cannot change what the runtime permits.</p>
						<a class="text-link text-link--light" href={href('/architecture/')}>
							See the architecture <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="boundary-sequence" data-reveal data-reveal-delay="1">
						<article class="boundary-row">
							<div class="boundary-mark" aria-hidden="true">
								<svg viewBox="0 0 34 34"><path d="M17 3 28 7.5v8.4c0 6.7-4.4 11.8-11 14.1C10.4 27.7 6 22.6 6 15.9V7.5L17 3Z" /><path d="m11.8 16.7 3.2 3.2 7.2-7.2" /></svg>
							</div>
							<div>
								<h3>Verify before trust</h3>
								<p>A sender ID is checked, not believed. Identity can help choose a route, but identity alone grants nothing.</p>
							</div>
							<code>event → verify → identify</code>
						</article>

						<article class="boundary-row">
							<div class="boundary-mark" aria-hidden="true">
								<svg viewBox="0 0 34 34"><path d="M5 8h24M8 17h18M11 26h12" /><circle cx="11" cy="8" r="2.5" /><circle cx="21" cy="17" r="2.5" /><circle cx="15" cy="26" r="2.5" /></svg>
							</div>
							<div>
								<h3>Compose a narrow grant</h3>
								<p>Routes, manifests, workflows, capability packs, and policy intersect. No matching allow means no authority.</p>
							</div>
							<code>route ∩ agent ∩ workflow ∩ policy</code>
						</article>

						<article class="boundary-row">
							<div class="boundary-mark" aria-hidden="true">
								<svg viewBox="0 0 34 34"><path d="M5 17h24" /><path d="M17 5v24" /><circle cx="17" cy="17" r="6" /><path d="m14.2 17 2 2 4-4" /></svg>
							</div>
							<div>
								<h3>Gate every effect</h3>
								<p>Before a connector touches the world, one gate returns allow, deny, or ask you first. The decision is audited.</p>
							</div>
							<code>run → gate → audit</code>
						</article>
					</div>
				</div>

				<div class="spine-statement" aria-hidden="true">
					<span>event</span><i></i><span>verify</span><i></i><span>route</span><i></i><span>compose</span><i></i><span>grant</span><i></i><span>gate</span><i></i><span>audit</span>
				</div>
			</section>

			<section class="lyra-section" aria-labelledby="lyra-title">
				<div class="section-shell">
					<header class="section-heading section-heading--split" data-reveal>
						<div>
							<span class="section-marker">The first product on the spine</span>
							<h2 id="lyra-title">Lyra helps with email.<br />The runtime keeps the boundary.</h2>
						</div>
						<div class="section-heading-copy">
							<p>Lyra is a Telegram-controlled personal assistant. Today it can work from a Gmail thread you selected, prepare a reply preview, and create a draft after approval. Sending stays denied by policy.</p>
							<span class="scope-note">Current alpha scope. The interface below is illustrative.</span>
						</div>
					</header>

					<div data-reveal data-reveal-delay="1">
						<LyraScenario />
					</div>
				</div>
			</section>

			<section class="proof-section" id="proof" aria-labelledby="proof-title">
				<div class="section-shell">
					<header class="proof-heading" data-reveal>
						<div>
							<span class="section-marker">Claims with failure modes</span>
							<h2 id="proof-title">Security claims should break when the proof disappears.</h2>
						</div>
						<p>Each documented claim maps to a named test. The build fails if a claimed test stops existing.</p>
					</header>

					<div class="claim-ledger" data-reveal data-reveal-delay="1">
						<div class="claim-ledger-head" aria-hidden="true">
							<span>Risk</span>
							<span>Runtime result</span>
							<span>Named test</span>
						</div>
						<article class="claim-row">
							<strong>Spoofed owner identity</strong>
							<p>Denied when the source was not verified.</p>
							<code>spoofed_owner_id_without_verified_source_is_denied</code>
						</article>
						<article class="claim-row">
							<strong>Reading another thread</strong>
							<p>Denied when it does not match the single-use selection token.</p>
							<code>email_read_selected_thread_rejects_foreign_grant</code>
						</article>
						<article class="claim-row">
							<strong>Credential exposure</strong>
							<p>The agent shell receives no raw connector credentials.</p>
							<code>process_driver_clears_env_and_sets_only_two_vars</code>
						</article>
						<article class="claim-row">
							<strong>Email send</strong>
							<p>Denied regardless of grant or approval state.</p>
							<code>global_policy_round_trips_and_denies_send</code>
						</article>
					</div>

					<div class="proof-actions" data-reveal>
						<a class="button button--ink" href={href('/threat-model/')}>Read every claim and test</a>
						<a class="text-link" href={`${repoUrl}/blob/main/docs/threat-claims.md`} target="_blank" rel="noreferrer">
							Open the source file <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="start-section" aria-labelledby="start-title">
				<div class="section-shell start-layout">
					<div class="start-copy" data-reveal>
						<span class="section-marker section-marker--dark">Build from the proof</span>
						<h2 id="start-title">Run the checks.<br />Then run the agent.</h2>
						<p>Clone OpenSpine, build the workspace, and run the same checks used by CI. The quickstart then walks through Telegram, Gmail, and model setup.</p>
						<div class="start-actions">
							<a class="button button--dark" href={href('/quickstart/')}>
								Open the quickstart <span aria-hidden="true">→</span>
							</a>
							<a class="button button--ghost-dark" href={repoUrl} target="_blank" rel="noreferrer">View on GitHub</a>
						</div>
						<p class="alpha-note"><strong>Alpha, honestly:</strong> the substrate and Lyra run end to end, but the roadmap still records what has not landed.</p>
					</div>

					<div class="command-panel" data-reveal data-reveal-delay="1">
						<div class="command-bar">
							<span>Terminal</span>
							<button type="button" class="copy-button" data-copy-command>
								<span class="copy-label">Copy</span>
							</button>
						</div>
						<pre><code data-command-text>{cloneCommand}</code></pre>
						<div class="command-result">
							<span class="status-light status-light--large" aria-hidden="true"></span>
							<span>Same test and claim checks as CI</span>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-main">
				<a class="brand brand--footer" href={`${base}/`} aria-label="OpenSpine home">
					<svg class="brand-symbol" viewBox="0 0 44 44" aria-hidden="true">
						<path d="M8 5h28v34H8z" />
						<path d="M14 13h16M14 22h16M14 31h16" />
						<circle cx="22" cy="13" r="2.7" />
						<circle cx="22" cy="22" r="2.7" />
						<circle cx="22" cy="31" r="2.7" />
					</svg>
					<span class="brand-word">OpenSpine</span>
				</a>
				<p>The backbone for agents you can trust with more.</p>
			</div>
			<nav class="footer-nav" aria-label="Footer navigation">
				<a href={href('/why-openspine/')}>Why OpenSpine</a>
				<a href={href('/architecture/')}>Architecture</a>
				<a href={href('/roadmap/')}>Roadmap</a>
				<a href={repoUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
			</nav>
			<a class="support-link" href="https://ko-fi.com/george_builds" target="_blank" rel="noreferrer">Support the work ↗</a>
		</footer>

		<script>
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

			const revealItems = document.querySelectorAll('[data-reveal]');
			if (reducedMotion.matches || !('IntersectionObserver' in window)) {
				revealItems.forEach((item) => item.classList.add('is-visible'));
			} else {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
				);
				revealItems.forEach((item) => revealObserver.observe(item));
			}

			const trace = document.querySelector('[data-trace]');
			const replayButton = document.querySelector('[data-trace-replay]');
			const runTrace = () => {
				if (!(trace instanceof HTMLElement) || reducedMotion.matches) return;
				trace.classList.remove('is-running');
				void trace.offsetWidth;
				trace.classList.add('is-running');
			};
			window.setTimeout(runTrace, 420);
			replayButton?.addEventListener('click', runTrace);

			if (trace instanceof HTMLElement && window.matchMedia('(pointer: fine)').matches && !reducedMotion.matches) {
				let frame = 0;
				trace.addEventListener('pointermove', (event) => {
					window.cancelAnimationFrame(frame);
					frame = window.requestAnimationFrame(() => {
						const bounds = trace.getBoundingClientRect();
						const x = (event.clientX - bounds.left) / bounds.width - 0.5;
						const y = (event.clientY - bounds.top) / bounds.height - 0.5;
						trace.style.setProperty('--tilt-y', `${x * 2.2}deg`);
						trace.style.setProperty('--tilt-x', `${y * -1.8}deg`);
					});
				});
				trace.addEventListener('pointerleave', () => {
					trace.style.setProperty('--tilt-y', '0deg');
					trace.style.setProperty('--tilt-x', '0deg');
				});
			}

			const copyButton = document.querySelector('[data-copy-command]');
			copyButton?.addEventListener('click', async () => {
				const command = document.querySelector('[data-command-text]')?.textContent?.trim();
				if (!command || !(copyButton instanceof HTMLButtonElement)) return;
				try {
					await navigator.clipboard.writeText(command);
					const label = copyButton.querySelector('.copy-label');
					if (label) label.textContent = 'Copied';
					window.setTimeout(() => {
						if (label) label.textContent = 'Copy';
					}, 1800);
				} catch {
					copyButton.classList.add('copy-failed');
					const label = copyButton.querySelector('.copy-label');
					if (label) label.textContent = 'Select text';
				}
			});

			let lastScroll = 0;
			const header = document.querySelector('[data-site-header]');
			window.addEventListener(
				'scroll',
				() => {
					const current = window.scrollY;
					if (header instanceof HTMLElement) {
						header.classList.toggle('is-scrolled', current > 12);
						header.classList.toggle('is-hidden', current > lastScroll && current > 220);
					}
					lastScroll = current;
				},
				{ passive: true },
			);
		</script>
	</body>
</html>
