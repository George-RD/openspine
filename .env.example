# .env.example — copy to .env and fill in real values before running.
# The .env file is gitignored; never commit it.

# ── Docker Compose ─────────────────────────────────────────────────────────
# Numeric group id of /var/run/docker.sock as the Linux daemon sees it. The
# non-root kernel container uses this as a supplemental group so it can spawn
# contained task workers. Do NOT `stat` the host path: on Docker Desktop and
# OrbStack it is a symlink into a VM and reports the wrong group. Run:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock busybox:1.36 \
#     stat -c '%g' /var/run/docker.sock
# (prints 0 on OrbStack, the docker group id on Linux)
DOCKER_GID=

# ── Telegram ──────────────────────────────────────────────────────────────
# Bot token from BotFather.
OPENSPINE_TELEGRAM_BOT_TOKEN=

# ── Artifact encryption ───────────────────────────────────────────────────
# 32-byte hex key used to AES-256-GCM-encrypt artifact blobs on disk.
# Generate with: openssl rand -hex 32
OPENSPINE_ARTIFACT_KEY=

# HMAC key used to seal task grants. Generate a separate random value
# (openssl rand -hex 32). Required: without it the kernel starts but denies
# every task and notifies the owner.
OPENSPINE_GRANT_HMAC_KEY=

# HMAC key for the kernel webhook verifier (separate random value, openssl
# rand -hex 32). The kernel does not start without it, and terminal chat needs
# it too because it starts the shared loopback HTTP service.
OPENSPINE_WEBHOOK_HMAC_KEY=

# ── Logging ───────────────────────────────────────────────────────────────
# The kernel server logs at `info` by default; set this to change the filter.
# RUST_LOG=debug

# ── Provider API keys (api_key auth mode) ─────────────────────────────────
# Onyx Personal Access Token scoped to `write:chat`.
ONYX_PAT=

# Anthropic API key (required if provider uses auth.mode = api_key).
ANTHROPIC_API_KEY=

# OpenAI-compat key if applicable.
# OPENAI_API_KEY=

# ── Gmail (optional) ──────────────────────────────────────────────────────
# Only needed if `gmail:` is configured in openspine.yaml (see
# docs/gmail-setup.md). These are the default env var names; the actual
# names are configurable per-deployment via `gmail.client_secret_env` /
# `gmail.refresh_token_env` in openspine.example.yaml.
OPENSPINE_GMAIL_CLIENT_SECRET=
OPENSPINE_GMAIL_REFRESH_TOKEN=
